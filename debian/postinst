#!/bin/sh
set -e

case "$1" in
    configure)
        # Add jsh to /etc/shells if not already present
        if [ -f /etc/shells ]; then
            if ! grep -q "^/usr/bin/jsh$" /etc/shells; then
                echo "/usr/bin/jsh" >> /etc/shells
            fi
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0

