# ~/.jshrc - JSH configuration file
# Copy this to ~/.jshrc to customize your shell

# ============================================================================
# Theme Configuration
# ============================================================================

# Set the theme (options: jsh, robbyrussell, agnoster, minimal, powerlevel, simple, pure)
export JSH_THEME="jsh"

# Or use a custom prompt:
# export PROMPT='%F{cyan}%n%f@%F{blue}%m%f:%F{yellow}%~%f$ '
# export RPROMPT='%F{8}%T%f'

# ============================================================================
# Environment Variables
# ============================================================================

# Default editor
export EDITOR="vim"
export VISUAL="$EDITOR"

# Pager
export PAGER="less"
export LESS="-R"

# History
export HISTSIZE=10000
export SAVEHIST=10000

